  ValtersIT rules for Wazuh.
  Install on the Wazuh manager as /var/ossec/etc/rules/valtersit_rules.xml
  Rule IDs 100700-100709 are reserved for this file; change them if they clash with your own
  local rules (anything in 100000-120000 is the local range).
-->
<group name="valtersit,vulnerability,">

  <rule id="100700" level="0">
    <decoded_as>valtersit</decoded_as>
    <field name="integration">^valtersit$</field>
    <description>ValtersIT: event grouping</description>
  </rule>

  <rule id="100701" level="3">
    <if_sid>100700</if_sid>
    <field name="event_type">^scan$</field>
    <description>ValtersIT: $(scanner) scan completed - $(scan.matched_cves) CVE(s) matched</description>
  </rule>

  <rule id="100702" level="5">
    <if_sid>100700</if_sid>
    <field name="event_type">^cve$</field>
    <description>ValtersIT: $(vulnerability.id) ($(vulnerability.severity), CVSS $(vulnerability.cvss_text)) in $(package.name) $(package.version)</description>
    <group>pci_dss_6.2,pci_dss_11.2.1,gdpr_IV_35.7.d,nist_800_53_RA.5,nist_800_53_SI.2,tsc_CC7.1,</group>
  </rule>

  <rule id="100703" level="10">
    <if_sid>100702</if_sid>
    <field name="vulnerability.severity">^high$</field>
    <description>ValtersIT: high severity $(vulnerability.id) (CVSS $(vulnerability.cvss_text)) in $(package.name) $(package.version)</description>
    <group>pci_dss_6.2,pci_dss_11.2.1,gdpr_IV_35.7.d,nist_800_53_RA.5,nist_800_53_SI.2,tsc_CC7.1,</group>
  </rule>

  <rule id="100704" level="13">
    <if_sid>100702</if_sid>
    <field name="vulnerability.severity">^critical$</field>
    <description>ValtersIT: CRITICAL $(vulnerability.id) (CVSS $(vulnerability.cvss_text)) in $(package.name) $(package.version) - fixed in $(package.fixed_version)</description>
    <group>pci_dss_6.2,pci_dss_11.2.1,gdpr_IV_35.7.d,nist_800_53_RA.5,nist_800_53_SI.2,tsc_CC7.1,</group>
  </rule>

</group>
